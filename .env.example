# Loop Engineering POC Configuration

# Model Configuration
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
GENERATION_MODEL=google/flan-t5-base
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=microsoft/deberta-v3-small
ISSUE_CLASSIFIER_MODEL=facebook/bart-large-mnli

# Device (cuda, mps, or cpu)
DEVICE=cpu

# Storage Paths
DATABASE_PATH=data/traces/loop_eng.db
FAISS_INDEX_PATH=data/embeddings/knowledge_base.faiss

# Loop Parameters
VERIFICATION_THRESHOLD=0.70
MAX_RETRIES=3
HILL_CLIMBING_BATCH_SIZE=100
HILL_CLIMBING_FREQUENCY=100  # Trigger every N reviews

# Logging
LOG_LEVEL=INFO

# Dataset
DATASET_NAME=amazon_polarity
DATASET_SPLIT=train[:10000]
